# =============================================================================
# MT-GRMS Backend Environment Variables (Template / Example)
# Hướng dẫn: Copy file này thành .env và cấu hình theo môi trường của bạn
# =============================================================================

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# 1. CHỌN CƠ SỞ DỮ LIỆU KẾT NỐI (Bỏ comment cấu hình bạn muốn dùng)
# -----------------------------------------------------------------------------

# Lựa chọn A: Local PostgreSQL (Mặc định cho các thành viên chạy máy cá nhân)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=mt_grms_dev;Username=postgres;Password=postgres;
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=mt_grms_dev;Username=postgres;Password=postgres;

# Lựa chọn B: Neon Cloud PostgreSQL (Dành cho thành viên dùng cloud DB)
# ConnectionStrings__DefaultConnection=Host=ep-flat-fog-b4lcgk76-pooler.c-6.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;
# DB_CONNECTION_STRING=Host=ep-flat-fog-b4lcgk76-pooler.c-6.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-flat-fog-b4lcgk76-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# -----------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC
# -----------------------------------------------------------------------------
# HMAC-SHA256 Secret Key for Tax Snapshot Audit Seal
TAX_AUDIT_SECRET_KEY=MT_GRMS_DEFAULT_TAX_SNAPSHOT_AUDIT_HMAC_SECRET_KEY_2026

# JWT Authentication Config
Jwt__Key=MT_GRMS_Super_Secret_Key_For_JWT_Authentication_2026_FPTU_Capstone_Project!
Jwt__Issuer=MTGRMS_API
Jwt__Audience=MTGRMS_CLIENT
Jwt__ExpiresMinutes=120
JWT_ISSUER=MTGRMS_API
JWT_AUDIENCE=MTGRMS_CLIENT
JWT_EXPIRES_MINUTES=120

# -----------------------------------------------------------------------------
# 3. THUẾ & DỊCH VỤ NGOÀI (Cấu hình bổ sung từ Dev)
# -----------------------------------------------------------------------------
# Tax Settings
TaxSettings__VatReductionDeadlineUtc=2026-12-31T17:00:00Z

# Cloudinary Cloud Storage Config
Cloudinary__CloudName=YOUR_CLOUDINARY_CLOUD_NAME
Cloudinary__ApiKey=YOUR_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=YOUR_CLOUDINARY_API_SECRET

# SePay VietQR Payment Gateway
SePay__ApiKey=YOUR_SEPAY_API_KEY
SePay__BankCode=MBBank
SePay__BankName=MB Bank (Ngân hàng Quân Đội)
SePay__AccountNumber=YOUR_ACCOUNT_NUMBER
SePay__AccountName=YOUR_ACCOUNT_NAME

# SMTP Email Settings (Gmail App Password)
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SenderEmail=your_email@gmail.com
EmailSettings__SenderName=MT-GRMS Hệ Thống Siêu Thị
EmailSettings__SmtpUser=your_email@gmail.com
EmailSettings__SmtpPass=your_16_char_app_password
EmailSettings__EnableSsl=true

# TextBee Android SMS Gateway (Lấy miễn phí tại https://textbee.dev)
TextBeeSettings__ApiKey=YOUR_TEXTBEE_API_KEY
TextBeeSettings__DeviceId=YOUR_TEXTBEE_DEVICE_ID
