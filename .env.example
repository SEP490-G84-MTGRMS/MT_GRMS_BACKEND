# =============================================================================
# MT-GRMS Backend Environment Variables (Template / Example)
# Copy this file to .env and configure your secret credentials
# =============================================================================

# Neon PostgreSQL Database Connection (URI format)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-flat-fog-b4lcgk76-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct ADO.NET Connection String (Alternative)
DB_CONNECTION_STRING=Host=ep-flat-fog-b4lcgk76-pooler.c-6.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;

# HMAC-SHA256 Secret Key for Tax Snapshot Audit Seal
TAX_AUDIT_SECRET_KEY=YOUR_SECURE_HMAC_SECRET_KEY_HERE

# JWT Authentication Config
JWT_ISSUER=MTGRMS_API
JWT_AUDIENCE=MTGRMS_CLIENT
JWT_EXPIRES_MINUTES=120

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development
